# ==============================================================================
# DIGITALMEERA ABSENSI - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# JWT Secret for Session & Tokens (Generate random 32+ character string in production)
AUTH_SECRET=

# Bootstrap Initial Administrator (Optional)
# If provided, the system creates the first admin on startup if no admin exists.
# If omitted, you can securely perform initial setup via the web onboarding setup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Database Connection (Optional if using PostgreSQL / Supabase / Neon in cloud)
DATABASE_URL=

# Google Sheets Reporting / Integration (Optional)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
